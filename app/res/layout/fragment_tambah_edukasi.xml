<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Custom Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Kembali"
                android:src="@drawable/ic_back_arrow"
                app:tint="#1B5E20" />

            <TextView
                android:id="@+id/tv_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Tambah Materi"
                android:textColor="#1B5E20"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Hidden Toolbar for code compatibility -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </RelativeLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#2E7D32"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeColor="#4CAF50"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Target Level Dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#E8F5E9"
                    app:boxStrokeColor="#A5D6A7"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <AutoCompleteTextView
                        android:id="@+id/spinner_level"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:hint="Target Level (1-3)"
                        android:textColor="#1B5E20"
                        android:textColorHint="#81C784"
                        android:padding="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Judul Utama -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#E8F5E9"
                    app:boxStrokeColor="#A5D6A7"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Judul Utama (misal: Dasar : Peduli Lingkungan)"
                        android:textColor="#1B5E20"
                        android:textColorHint="#81C784" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Deskripsi Singkat -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#E8F5E9"
                    app:boxStrokeColor="#A5D6A7"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Deskripsi Singkat (Deskripsi Misi)"
                        android:textColor="#1B5E20"
                        android:textColorHint="#81C784" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Image Area matching screenshot style (Lavender/Purple) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_select_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#F3E5F5"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D1C4E9"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="130dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            android:layout_marginBottom="8dp"
                            app:strokeWidth="0dp">
                            <ImageView
                                android:id="@+id/iv_preview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_lingkungan"
                                android:contentDescription="Preview Gambar" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false"
                            app:boxBackgroundColor="#E1BEE7"
                            app:boxStrokeColor="#7B1FA2"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_imageUrl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Nama Drawable Gambar (misal: ling..."
                                android:textColor="#000000"
                                android:textColorHint="#9C27B0"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tv_image_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Klik area ini untuk upload dari galeri"
                            android:gravity="center"
                            android:textSize="11sp"
                            android:textColor="#7B1FA2"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section 1 -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#E8F5E9"
                    app:boxStrokeColor="#A5D6A7"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_section1Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Judul Section 1 (misal: Apa itu Peduli...)"
                        android:textColor="#1B5E20"
                        android:textColorHint="#81C784" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#E8F5E9"
                    app:boxStrokeColor="#A5D6A7"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_section1Content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:minLines="3"
                        android:hint="Isi Materi Section 1"
                        android:textColor="#1B5E20"
                        android:textColorHint="#81C784" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section 2 -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#E8F5E9"
                    app:boxStrokeColor="#A5D6A7"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_section2Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Judul Section 2 (misal: Kenapa Penting?)"
                        android:textColor="#1B5E20"
                        android:textColorHint="#81C784" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#E8F5E9"
                    app:boxStrokeColor="#A5D6A7"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_section2Content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:minLines="3"
                        android:hint="Isi Materi Section 2"
                        android:textColor="#1B5E20"
                        android:textColorHint="#81C784" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section 3 -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#E8F5E9"
                    app:boxStrokeColor="#A5D6A7"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_section3Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Judul Section 3 (misal: Contoh Perilaku)"
                        android:textColor="#1B5E20"
                        android:textColorHint="#81C784" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#E8F5E9"
                    app:boxStrokeColor="#A5D6A7"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_section3Content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:minLines="3"
                        android:hint="Isi Materi Section 3 (Gunakan • untuk list)"
                        android:textColor="#1B5E20"
                        android:textColorHint="#81C784" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_aktif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status Aktif"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:checked="true" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="#1B5E20"
            android:text="SIMPAN MATERI"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="30dp" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
