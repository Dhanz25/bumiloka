<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Background Decorations -->
        <ImageView
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="top|end"
            android:alpha="0.06"
            android:contentDescription="@string/content_desc_leaf"
            android:src="@drawable/ic_leaf"
            android:translationX="80dp"
            android:translationY="-40dp"
            app:tint="#1B5E20" />

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="bottom|start"
            android:alpha="0.06"
            android:contentDescription="@string/content_desc_eco"
            android:src="@drawable/ic_eco"
            android:translationX="-60dp"
            android:translationY="60dp"
            app:tint="#1B5E20" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/back_button_desc"
                    android:padding="4dp"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="#1B5E20" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/jelajahi_materi"
                    android:textColor="#1B5E20"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#F8F9F9"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:text="@string/deskripsi_misi"
                        android:textColor="#1B5E20"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_target"
                        app:drawableTint="#388E3C" />

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4sp"
                        android:textColor="#455A64"
                        android:textSize="14sp"
                        tools:text="Baca dan pahami materi ini sebagai langkah awal menjaga bumi kita tetap hijau." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Main Content Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#2E7D32"
                app:cardCornerRadius="24dp"
                app:cardElevation="10dp"
                app:strokeColor="#4CAF50"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvJudulUtama"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#F0F4C3"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Dasar : Peduli Lingkungan" />

                    <!-- AREA GAMBAR DENGAN TINGGI TETAP (200dp) & CENTER CROP -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/imgMateri"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/materi_icon_desc"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_launcher_background" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Section 1 -->
                    <TextView
                        android:id="@+id/tvIsiTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_help"
                        app:drawableTint="#F0F4C3"
                        tools:text="Judul Seksi 1" />

                    <TextView
                        android:id="@+id/tvIsiMateri"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="#E8F5E9"
                        android:textSize="15sp"
                        tools:text="Konten Seksi 1" />

                    <!-- Section 2 -->
                    <TextView
                        android:id="@+id/tvContohTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_tips"
                        app:drawableTint="#F0F4C3"
                        tools:text="Judul Seksi 2" />

                    <TextView
                        android:id="@+id/tvContohContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="#E8F5E9"
                        android:textSize="15sp"
                        tools:text="Konten Seksi 2" />

                    <!-- Section 3 -->
                    <TextView
                        android:id="@+id/tvSection3Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_medal"
                        app:drawableTint="#F0F4C3"
                        tools:text="Judul Seksi 3" />

                    <TextView
                        android:id="@+id/tvSection3Content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="#E8F5E9"
                        android:textSize="15sp"
                        tools:text="Konten Seksi 3" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLanjut"
                android:layout_width="220dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:layout_marginTop="36dp"
                android:layout_marginBottom="32dp"
                android:text="@string/quiz_btn_next"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#388E3C"
                app:cornerRadius="30dp"
                app:elevation="6dp" />

        </LinearLayout>
    </FrameLayout>
</ScrollView>
