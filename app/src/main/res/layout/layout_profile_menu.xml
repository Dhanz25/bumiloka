<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_menu_flat"
    android:orientation="vertical"
    android:clipToOutline="true">

    <!-- 🌿 PROFILE HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_menu_header"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/menuIvProfile"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="@color/dark_green"
            app:strokeWidth="2dp"/>

        <TextView
            android:id="@+id/menuUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Nama Pengguna"
            android:textColor="@color/dark_green"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <!-- ⚙️ MENU ACTIONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuPengaturan"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Pengaturan Profil"
            android:textColor="@color/text_black"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            app:icon="@drawable/ic_setting"
            app:iconTint="@color/dark_green"
            app:iconSize="22dp"
            app:cornerRadius="16dp"
            android:textAllCaps="false"
            android:textSize="14sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuKeluar"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Keluar Akun"
            android:textColor="#D32F2F"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            app:icon="@drawable/ic_logout"
            app:iconTint="#D32F2F"
            app:iconSize="22dp"
            app:cornerRadius="16dp"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
