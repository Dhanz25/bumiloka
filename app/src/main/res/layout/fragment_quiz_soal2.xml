<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#E8F5E9">

    <!-- Header with Back Button and Centered Title -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="@string/back_button_desc" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/quiz_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2E7D32" />
    </RelativeLayout>

    <!-- Pertanyaan -->
    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/quiz_question_placeholder"
        android:textSize="18sp"
        android:textColor="#333333"
        android:layout_marginBottom="24dp"
        android:lineSpacingExtra="4dp"/>

    <!-- OPTION -->
    <LinearLayout
        android:id="@+id/optionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Option A -->
        <TextView
            android:id="@+id/option1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_option"
            android:padding="16dp"
            android:text="A. Pilihan 1"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <!-- Option B -->
        <TextView
            android:id="@+id/option2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_option"
            android:padding="16dp"
            android:text="B. Pilihan 2"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <!-- Option C -->
        <TextView
            android:id="@+id/option3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_option"
            android:padding="16dp"
            android:text="C. Pilihan 3"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <!-- Option D -->
        <TextView
            android:id="@+id/option4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_option"
            android:padding="16dp"
            android:text="D. Pilihan 4"
            android:textSize="16sp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Tombol Lanjut -->
    <Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/quiz_btn_next"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        app:cornerRadius="12dp"/>

</LinearLayout>