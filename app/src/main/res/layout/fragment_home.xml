<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    tools:context=".HomeFragment">

    <!-- 🎨 BACKGROUND DECOR -->
    <View
        android:layout_width="450dp"
        android:layout_height="450dp"
        android:background="@drawable/bg_blob_soft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="-180dp"
        android:layout_marginTop="-120dp"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:background="@drawable/bg_blob_secondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="-140dp"
        android:layout_marginBottom="60dp"
        android:importantForAccessibility="no" />

    <!-- Efek Gradasi Header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/bg_home_header"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-3940256099942544/6300978111"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/adView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">

                <LinearLayout
                    android:id="@+id/headerTextContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivProfile"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Halo, Bumi Lover! 🌍"
                        android:textColor="@color/dark_green"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mari selamatkan planet kita bersama"
                        android:textColor="@color/text_subtitle"
                        android:textSize="15sp"
                        android:layout_marginTop="2dp"
                        android:alpha="0.8" />
                </LinearLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeColor="@color/white"
                    app:strokeWidth="3dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Banner Level Premium -->
            <LinearLayout
                android:id="@+id/btnLevelDashboard"
                android:layout_width="match_parent"
                android:layout_height="165dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_level1"
                android:orientation="horizontal"
                android:clipToOutline="true">

                <RelativeLayout
                    android:id="@+id/rlLevelBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Ornamen 1 -->
                    <ImageView
                        android:id="@+id/ivOrnamen1"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="-40dp"
                        android:layout_marginEnd="-40dp"
                        android:alpha="0.25"
                        android:src="@drawable/ic_leaf"
                        app:tint="@color/white" />

                    <!-- Ornamen 2 -->
                    <ImageView
                        android:id="@+id/ivOrnamen2"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="-25dp"
                        android:alpha="0.2"
                        android:src="@drawable/ic_eco"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_centerVertical="true"
                        android:paddingHorizontal="32dp">

                        <TextView
                            android:id="@+id/tvLevelTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏅 Level 1"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/pbTargetProgress"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:layout_marginTop="24dp"
                            android:progressTint="#00E676"
                            android:progressBackgroundTint="#4DFFFFFF" />

                        <TextView
                            android:id="@+id/tvProgressPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="0% tercapai"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>

            <!-- Grid Menu Utama -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginTop="24dp">

                <!-- 📖 EDUKASI -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnEdukasi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="10dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E8F5E9"
                    app:cardBackgroundColor="#F1FBF4">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="145dp"
                        android:clipToPadding="false">
                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="-20dp"
                            android:layout_marginEnd="-25dp"
                            android:alpha="0.08"
                            android:src="@drawable/ic_edukasi"
                            app:tint="#2E7D32"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">
                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_icon_circle_green"
                                android:padding="16dp"
                                android:src="@drawable/ic_edukasi"
                                app:tint="#2E7D32"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Edukasi"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_marginTop="14dp"
                                android:textColor="@color/dark_green"/>
                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 🎯 MISI -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnMisi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="10dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E3F2FD"
                    app:cardBackgroundColor="#F0F7FF">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="145dp"
                        android:clipToPadding="false">
                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="-25dp"
                            android:layout_marginBottom="-20dp"
                            android:alpha="0.08"
                            android:src="@drawable/ic_misi"
                            app:tint="#2196F3"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">
                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_icon_circle_blue"
                                android:padding="16dp"
                                android:src="@drawable/ic_misi"
                                app:tint="#2196F3"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Misi"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_marginTop="14dp"
                                android:textColor="#1976D2"/>
                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 🏆 TANTANGAN -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnTantangan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="10dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#F1F8E9"
                    app:cardBackgroundColor="#F9FFF5">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="145dp"
                        android:clipToPadding="false">
                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="-25dp"
                            android:layout_marginBottom="-20dp"
                            android:alpha="0.08"
                            android:src="@drawable/ic_tantangan"
                            app:tint="#4CAF50"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">
                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_icon_circle_green"
                                android:padding="16dp"
                                android:src="@drawable/ic_tantangan"
                                app:tint="#4CAF50"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tantangan"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_marginTop="14dp"
                                android:textColor="#388E3C"/>
                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 📝 KUIS -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnKuis"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="10dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#FFF8E1"
                    app:cardBackgroundColor="#FFFEF5">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="145dp"
                        android:clipToPadding="false">
                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="-30dp"
                            android:alpha="0.08"
                            android:src="@drawable/ic_quiz"
                            app:tint="#FFC107"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">
                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_icon_circle_yellow"
                                android:padding="16dp"
                                android:src="@drawable/ic_quiz"
                                app:tint="#FFC107"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kuis"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_marginTop="14dp"
                                android:textColor="#F57C00"/>
                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <!-- Card Rekomendasi (PREMIUM DESIGN) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F8E9">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false">

                    <!-- Ornamen Utama: Lampu Ide Besar di Kanan (Glow Effect) -->
                    <ImageView
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="-40dp"
                        android:alpha="0.07"
                        android:src="@drawable/ic_tips"
                        app:tint="#FFD54F"/>

                    <!-- Ornamen Pendukung: Lingkaran Halo di belakang Lampu -->
                    <ImageView
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="-60dp"
                        android:alpha="0.04"
                        android:src="@drawable/bg_badge_circle"
                        app:tint="#FFC107"/>

                    <!-- Ornamen Daun di Kiri Bawah untuk kesan natural -->
                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="-30dp"
                        android:layout_marginBottom="-30dp"
                        android:alpha="0.05"
                        android:src="@drawable/ic_leaf"
                        app:tint="#81C784"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="28dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_tips"
                                app:tint="@color/dark_green"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:text="Rekomendasi Hari Ini"
                                android:textColor="@color/dark_green"
                                android:textSize="20sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvRekomendasiHariIni"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:fontFamily="sans-serif-medium"
                            android:lineSpacingExtra="8dp"
                            android:text="Ayo mulai langkah kecilmu hari ini!"
                            android:textColor="@color/text_title"
                            android:textSize="18sp" />
                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Bahasa Jawa (Javanese Traditional Plant Aesthetic) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBahasaJawa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="40dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FDFBF7"
                app:strokeWidth="1.5dp"
                app:strokeColor="#E8E4D8">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false">

                    <!-- 🌿 Ornamen Lung-lungan (Traditional Vine Cluster) - Top Left -->
                    <ImageView
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="-45dp"
                        android:layout_marginTop="-40dp"
                        android:alpha="0.08"
                        android:rotation="-25"
                        android:src="@drawable/ic_leaf"
                        app:tint="#2E7D32"/>

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="-10dp"
                        android:layout_marginTop="-20dp"
                        android:alpha="0.05"
                        android:rotation="45"
                        android:src="@drawable/ic_leaf"
                        app:tint="#1B5E20"/>

                    <!-- 🌿 Ornamen Lung-lungan - Bottom Right Cluster -->
                    <ImageView
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="-50dp"
                        android:layout_marginBottom="-45dp"
                        android:alpha="0.07"
                        android:rotation="155"
                        android:src="@drawable/ic_leaf"
                        app:tint="#1B5E20"/>

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="-10dp"
                        android:alpha="0.04"
                        android:rotation="10"
                        android:src="@drawable/ic_leaf"
                        app:tint="#2E7D32"/>

                    <!-- 🌳 Center Mandala (Gunungan Style Peak) -->
                    <ImageView
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="-80dp"
                        android:alpha="0.03"
                        android:src="@drawable/bg_badge_circle"
                        app:tint="#795548"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Icon Header -->
                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_icon_circle_yellow"
                                android:backgroundTint="#FFF3E0"
                                android:padding="14dp"
                                android:src="@drawable/ic_leaf"
                                app:tint="#8D6E63"/>

                            <LinearLayout
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bahasa Jawa Hari Ini"
                                    android:textStyle="bold"
                                    android:textSize="18sp"
                                    android:textColor="#3E2723"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sinau tembung lingkungan"
                                    android:textSize="13sp"
                                    android:textColor="#6D4C41"/>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="#F4F7F1"
                            android:padding="20dp"
                            android:layout_marginTop="20dp">

                            <TextView
                                android:id="@+id/tvKosakata"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌳 Wit = Pohon"
                                android:textStyle="bold"
                                android:textSize="26sp"
                                android:textColor="#1B5E20"/>

                            <TextView
                                android:id="@+id/tvContohKalimat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ayo nandur wit kanggo bumi sing luwih ijo"
                                android:textSize="16sp"
                                android:textStyle="italic"
                                android:textColor="#2E7D32"
                                android:layout_marginTop="12dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="24dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMulaiKuisJawa"
                                android:layout_width="wrap_content"
                                android:layout_height="56dp"
                                android:text="Mulai Kuis"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:backgroundTint="#4E342E"
                                app:cornerRadius="20dp"
                                app:icon="@drawable/ic_arrow"/>

                            <ImageView
                                android:id="@+id/imgMaskotJawa"
                                android:layout_width="110dp"
                                android:layout_height="110dp"
                                android:layout_marginStart="24dp"
                                android:layout_gravity="end"
                                android:alpha="0.9"
                                android:src="@drawable/maskot"/>
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
