<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background">

    <!-- 🎨 BACKGROUND DECOR -->
    <View
        android:layout_width="450dp"
        android:layout_height="450dp"
        android:layout_marginEnd="-180dp"
        android:layout_marginTop="-120dp"
        android:alpha="0.6"
        android:background="@drawable/bg_blob_soft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:layout_marginStart="-140dp"
        android:layout_marginBottom="60dp"
        android:alpha="0.6"
        android:background="@drawable/bg_blob_secondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:importantForAccessibility="no" />

    <!-- Efek Gradasi Header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@drawable/bg_home_header"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 🔝 TOOLBAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Tips Lingkungan"
            app:titleCentered="true"
            app:titleTextColor="@color/dark_green"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 🔽 CONTENT AREA -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <!-- 📜 LIST TIPS (PREMIUM DESIGN) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- CARD 1: PEDULI LINGKUNGAN -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTips1"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#E8F5E9"
                    app:cardBackgroundColor="@color/white">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/gambar_peduli_lingkungan"
                            android:contentDescription="Tips Peduli Lingkungan" />

                        <!-- Bottom Scrim for Readability -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_alignParentBottom="true"
                            android:background="@drawable/bg_scrim_bottom" />

                        <!-- Top-Right Ornament peek -->
                        <ImageView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="-20dp"
                            android:layout_marginEnd="-20dp"
                            android:alpha="0.25"
                            android:src="@drawable/ic_tips"
                            app:tint="@color/white" />

                        <!-- Category Badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="#CCFFFFFF"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="EKOSISTEM"
                            android:textColor="@color/dark_green"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_margin="24dp"
                            android:text="Peduli Lingkungan"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.01"/>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CARD 2: LIMBAH -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTips2"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#E3F2FD"
                    app:cardBackgroundColor="@color/white">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_sampah"
                            android:contentDescription="Tips Limbah" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_alignParentBottom="true"
                            android:background="@drawable/bg_scrim_bottom" />

                        <ImageView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="-20dp"
                            android:layout_marginEnd="-20dp"
                            android:alpha="0.25"
                            android:src="@drawable/ic_tips"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="#CCFFFFFF"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="LIMBAH"
                            android:textColor="#1976D2"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_margin="24dp"
                            android:text="Kenalan Sama Sampah"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CARD 3: AIR -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTips3"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginBottom="40dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#FFF8E1"
                    app:cardBackgroundColor="@color/white">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/hematair"
                            android:contentDescription="Tips Hemat Air" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_alignParentBottom="true"
                            android:background="@drawable/bg_scrim_bottom" />

                        <ImageView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="-20dp"
                            android:layout_marginEnd="-20dp"
                            android:alpha="0.25"
                            android:src="@drawable/ic_tips"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="#CCFFFFFF"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="AIR"
                            android:textColor="#F57C00"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_margin="24dp"
                            android:text="Cara Menghemat Air"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 🔁 EMPTY STATE -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="160dp"
                android:layout_height="160dp"
                app:cardBackgroundColor="#F9FBF9"
                app:cardCornerRadius="80dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center"
                    android:alpha="0.4"
                    android:src="@drawable/lock"
                    app:tint="@color/dark_green"
                    android:importantForAccessibility="no" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Tips Masih Terkunci"
                android:textColor="@color/dark_green"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="Selesaikan kuis untuk membuka tips bermanfaat ini."
                android:textColor="@color/text_subtitle"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
